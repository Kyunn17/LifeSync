DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
PORT=3001
NODE_ENV=production
BETTER_AUTH_SECRET=replace_with_a_secure_32_char_secret_key
BETTER_AUTH_URL=https://lifesyncapi-production.up.railway.app
FRONTEND_URL=http://localhost:3000

# Brevo HTTPS API (Recommended for Cloud Hosting - never blocked by Railway)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Gmail SMTP (Optional fallback)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_digit_google_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_gmail@gmail.com
MAIL_FROM_NAME="LifeSync Wellness"
REQUIRE_EMAIL_VERIFICATION=true
